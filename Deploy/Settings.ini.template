[FarmWatchdog]
Enabled=0
; Independent positive-integer thresholds in seconds.
Farm_Stall_Duration=180
Match_Stall_Duration=1200
NoGame_Duration=60

[Logging]
; Log level: DEBUG / INFO / WARN / ERROR
LogLevel=DEBUG
; Max recent log files to keep
MaxLogFiles=10

[Overlay]
; Enable overlay on startup (0=disabled, 1=enabled)
Enabled=0
; Panel opacity (40-100)
Opacity=80
; Detection update interval (ticks, 1 tick = 1 second)
UpdateInterval=3
; Reposition interval (ticks, 1 tick = 1 second)
PositionInterval=15
; Font size (8-12)
FontSize=9

[RestartGame]
Enabled=0
; Run mode: once / loop
Mode=once
; Max loops (0=unlimited, loop mode only)
MaxLoops=0
; Delay between loops (seconds)
LoopDelay=30
; Max error retries
MaxRetries=3

; Window stabilize wait (ms) — wait for login screen after game window appears
StabilizeWaitTime=10000

; Launcher button coords (relative to launcher window client area)
Launcher_Button_X=2288
Launcher_Button_Y=1137
; Launcher load wait time (seconds)
Launcher_WaitTime=5

