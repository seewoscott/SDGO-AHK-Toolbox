; ===== Server Profiles =====
; Each [Server.*] section defines a server config.
; Priority: [Server.<ServerProfile>] → [General] → hardcoded default.
; Switch via Settings tab dropdown, or edit [Game] > ServerProfile directly.

[Server.OC_ASIA]
; Supported modules (comma-separated)
Modules=RestartGame,FarmWatchdog,AutoFarm,AutoFarmMulti,AutoMatch
; Confirming battle mode keeps the current channel tier and opens the battle lobby directly.
BattleDirectLobby=1
; Game process name
GameExe=gonline.exe
; Launcher filename
LauncherExe=SDGO_Launcher.exe
; Game directory (empty = Desktop\SDGO UNION 1.4.3)
GameDir=
; Launcher full path (empty = GameDir\LauncherExe)
GamePath=
; Login password
LoginPassword=
; Channel detect pixel color (0xRRGGBB)
LoginChannelColor=0x071940
; Log directory (empty = GameDir\zoG_log)
LogDir=

[AutoMatch]
Enabled=0
; Max matches (0=unlimited)
MaxRuns=0

; Room action retry interval (seconds)
ReadyTimeout=5

; Weapon selection keys
PrimaryWeaponKey=1
LockWeaponKey=2
; Result pixel color (center 3x3 grid area)
ResultColor=0x25B3D1

; Attack duration (seconds) — how long to attack before checking for result screen
AttackDuration=60

[Server.OC_CHINA]
; Supported modules (comma-separated)
Modules=AutoMatch
