[General]
; Global hotkey modifier for module toggles: ^=Ctrl, !=Alt, #=Win
HotkeyModifier=^!
; Emergency stop key — stops all modules
EmergencyStop=Esc
; Game process name
GameExe=gonline.exe

[Updater]
; LAN shared folder containing SDGO-Toolbox.exe and version.json.
; Set ShareFolder blank to disable a configured distribution location.
Enabled=1
ShareFolder=\\192.168.124.3\Windows share
VersionFile=version.json
; 周期检查间隔(分钟): 挂机期间自动检测新版本, 0=仅启动时检查一次
CheckIntervalMinutes=30

[Game]
; Window size (for coordinate calculation)
WindowWidth=1024
WindowHeight=768
; Input mode: control=ControlSend(background), setforeground=activate first then Send
InputMode=control
; Active server profile (matches [Server.*] section)
ServerProfile=OC_ASIA

[AutoFarm]
Enabled=0
; Max runs (0=unlimited)
MaxRuns=10
; Mission select coords
Mission_Select_X=800
Mission_Select_Y=200
Mission_Confirm_X=512
Mission_Confirm_Y=500
; Phase timeouts (seconds)
Timeout_Select=30
Timeout_Queue=120
Timeout_Loading=60
Timeout_Battle=600
Timeout_Result=30

